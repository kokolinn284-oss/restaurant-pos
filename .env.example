# ------------------------------------------------------------------
# Restaurant POS — environment variables
# Hostinger panel မှာ ဒီတန်ဖိုးတွေကို တိုက်ရိုက်ထည့်နိုင်ပါတယ်။
# Local မှာ စမ်းသပ်ရန်: copy လုပ်ပြီး .env ဟု နာမည်ပြောင်း၊
# `node --env-file=.env server/index.js` ဖြင့် run ပါ။
# ------------------------------------------------------------------

# Server ရဲ့ port (Hostinger က PORT ကို အလိုအလျောက် ပေးတတ်သည်)
PORT=3000

# Database၊ upload ပုံများ သိမ်းမည့် folder — absolute path ဖြစ်ရမည်။
# Hostinger Web App တွင် hbuilds/current အပြင်ဘက်မှာ ထားပါ။
POS_DATA_DIR=/home/USERNAME/pos-data

# Backup (.db) ဖိုင်များ သိမ်းမည့် folder
POS_BACKUP_DIR=/home/USERNAME/pos-backups

# Nginx / reverse proxy နောက်မှာ run လျှင် 1 ထားပါ (rate limit နှင့် IP မှန်စေရန်)
POS_TRUST_PROXY=1

# production / development
NODE_ENV=production
